# Copy to .env and fill in your local values:
#   cp .env.example .env

# MySQL connection (used by Flask app via mysql.py)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/mindscope

# Google Maps / Places (service mapping map + facility search)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Tavily (optional — facility search pipeline)
TAVILY_API_KEY=your_tavily_api_key_here
